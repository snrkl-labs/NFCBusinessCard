<?xml version="1.0" encoding="utf-8"?>
<!--
    The home screen widget, at any size between 3x2 and 5x2 cells.

    RemoteViews, not Compose Glance: Glance would add a dependency and a second
    UI toolkit for one small surface, and this layout is a handful of views.

    Nothing here is rotated — unlike Full Card Mode inside the app, where the
    phone stays upright and the card turns. The widget is already landscape, so
    the card reads normally and the buttons are upright beside it.

    **No background.** The tile is transparent and only its contents paint, so
    the widget sits on the wallpaper rather than cutting a rectangle out of it.
    That is why the two buttons carry their own grounds and the caption carries
    a shadow: on a transparent tile every element has to be legible against an
    unknown wallpaper, not against a ground this layout controls.

    One layout serves both sizes. The button column is simply hidden when the
    widget is too narrow to earn it — see CardWidgetProvider. A second layout
    would be a second thing to keep in step for the sake of one GONE.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:padding="8dp">

    <!--
        Tapping either of these opens the app in Full Card Mode.

        The image is wrap_content with adjustViewBounds, so it sizes itself to
        whatever it is showing: a landscape card takes the width it needs, while
        a square QR takes only a square. The caption beside it then fills what is
        left — which is the point, since a code alone leaves a landscape widget
        looking half empty. The caption is GONE for a card, and contributes no
        width in that state.

        A RelativeLayout rather than a second weighted LinearLayout: this slot
        already sits inside a weight, and a weight nested in a weight makes the
        parent measure its children twice on every pass. Positioning the caption
        after the image gets the same result for one measure.
    -->
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/widget_card_image"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:contentDescription="@string/widget_card_description" />

        <TextView
            android:id="@+id/widget_card_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/widget_card_image"
            android:layout_centerVertical="true"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:maxLines="4"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textColor="@color/widget_caption"
            android:shadowColor="@color/widget_caption_shadow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="3"
            android:visibility="gone" />
    </RelativeLayout>

    <!--
        Hidden below about four columns: at 3x2 the card wants the whole tile,
        and two 48dp controls squeezed beside it would leave neither readable.
        Everything they do is one tap further in from the card itself.
    -->
    <LinearLayout
        android:id="@+id/widget_buttons"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="0dp">

        <ImageView
            android:id="@+id/widget_nfc_button"
            android:layout_width="48dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="4dp"
            android:background="@drawable/widget_button_background"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/widget_nfc_description" />

        <ImageView
            android:id="@+id/widget_qr_button"
            android:layout_width="48dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_button_background"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/widget_qr_description" />
    </LinearLayout>

</LinearLayout>
