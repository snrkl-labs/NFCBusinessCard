<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The real theming lives in Compose (ui/theme/Theme.kt). This XML theme only
        has to carry the app to the first frame without a flash of the wrong
        colour, so it sets the window background and nothing else.
    -->
    <style name="Theme.NFCBusinessCard" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
